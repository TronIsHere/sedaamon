# Copy to .env.local (development) or .env.production (server). Never commit the copy.
# Full reference: docs/en/configuration.md

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
# Address the app listens on. 0.0.0.0 inside Docker; use 127.0.0.1 when only nginx/Caddy on this machine talks to it.
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/sedaamon

# The public address people open in the browser. Used for canonical links, the sitemap, share images and llms.txt.
SITE_URL=http://localhost:3000
# Optional; shown on the about and privacy pages and in the site's structured data.
SITE_CONTACT_EMAIL=
# Optional; the eNAMAD trust seal in the footer (Iranian domains). Both values must be set.
ENAMAD_ID=
ENAMAD_CODE=
# Optional; the Apple Developer team that signs the macOS app, for Universal Links (desktop/README.md).
APPLE_TEAM_ID=
# Development only: extra hosts allowed to load the dev server, e.g. a phone on your Wi-Fi (comma separated).
DEV_ALLOWED_ORIGINS=

# ── Admin panel ──────────────────────────────────────────────────────────────
# Phone numbers (09xxxxxxxxx, comma separated) that can open /admin. Empty = the admin panel is off.
ADMIN_PHONES=

# ── Login SMS ────────────────────────────────────────────────────────────────
# "console" prints the login code to the log (and, outside production, shows it on the login screen).
# "kavenegar" sends a real SMS through a Kavenegar verify/lookup template that has a single %token.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# ── LiveKit (voice and video) ────────────────────────────────────────────────
# Must match the keys: section of livekit.yaml (livekit.dev.yaml in development).
# These dev values are rejected in production. Generate real ones:  openssl rand -hex 24
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-local-only-not-for-production
# How this server reaches LiveKit's HTTP API (same machine or Docker network).
LIVEKIT_URL=http://127.0.0.1:7880
# How browsers reach LiveKit. In production this must be wss:// (HTTPS pages can't open ws://).
# Leave it empty in development: phones on your network are then pointed at this machine automatically.
LIVEKIT_PUBLIC_URL=

# ── File storage ─────────────────────────────────────────────────────────────
# Leave S3_ENDPOINT empty to keep uploads on this machine, in UPLOAD_DIR.
UPLOAD_DIR=uploads
# Or use any S3-compatible bucket (MinIO, Arvan, ParsPack, AWS…). The bucket can stay private:
# files are served through the app with the channel's own access rules.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Largest film the cinema library accepts, in MB (at most 5120). Needs that much free disk in UPLOAD_DIR while it arrives.
MOVIE_MAX_MB=4096
# Lets "download from link" in the admin panel fetch from private and local addresses (LAN, localhost).
# Off by default so the server can't be pointed at things only it can reach.
# MOVIE_IMPORT_ALLOW_PRIVATE=true
# Where ffmpeg and ffprobe are, if not on the PATH. They repackage films for Safari (a button in the admin panel).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
