# Copy to .env.local (development) or .env.production (server).

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sedaamon

# The public address, used for canonical links, the sitemap, share images and llms.txt (default: https://seda.arzhaam.ir).
SITE_URL=
# Optional; shown on the about and privacy pages and in the site's structured data.
SITE_CONTACT_EMAIL=

# Phones that can open the admin panel at /admin, comma separated (default: 09306613683).
ADMIN_PHONES=09306613683

# "console" prints the login code to the log (development only); "kavenegar" sends a real SMS.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Must match the key/secret in livekit.yaml (livekit.dev.yaml in development).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-local-only-not-for-production
# How this server reaches LiveKit's HTTP API (same machine).
LIVEKIT_URL=http://127.0.0.1:7880
# How browsers reach LiveKit. In production this must be wss:// (HTTPS pages can't open ws://).
# Leave it empty in development: phones on your network are then pointed at this machine automatically.
LIVEKIT_PUBLIC_URL=

# Where uploaded pictures and files are kept. With S3_ENDPOINT set, an S3-compatible bucket (ParsPack, Arvan, MinIO…);
# the bucket can stay private, since files are served through the app with the channel's own access rules.
# Leave it empty to keep files on this machine, in UPLOAD_DIR (default ./uploads).
S3_ENDPOINT=https://c155795.parspack.net
S3_BUCKET=c155795
S3_ACCESS_KEY_ID=KblmZFMi4PQcEnUG
S3_SECRET_ACCESS_KEY=Vq10xz9BM22wfqCgjlg2pBNn4d5XCaLp
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
UPLOAD_DIR=sedaamon_uploads
