# Copy to .env.local (development) or .env.production (server).

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sedaamon

# "console" prints the login code to the log (development only); "kavenegar" sends a real SMS.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Must match the key/secret in livekit.yaml (livekit.dev.yaml in development).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-local-only-not-for-production
# How this server reaches LiveKit's HTTP API (same machine).
LIVEKIT_URL=http://127.0.0.1:7880
# How browsers reach LiveKit. In production this must be wss:// (HTTPS pages can't open ws://).
# Leave it empty in development: phones on your network are then pointed at this machine automatically.
LIVEKIT_PUBLIC_URL=
